---
interface Props {
	eyebrow: string;
	title: string;
	description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="section-header">
	<p class="eyebrow">{eyebrow}</p>
	<h2 class="text-balance">{title}</h2>
	{description && <p class="muted text-pretty">{description}</p>}
</header>

<style>
	.section-header {
		max-width: 42rem;
	}

	.section-header h2 {
		margin: 0.55rem 0 0;
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 3.5rem);
		font-weight: 650;
		letter-spacing: 0;
		line-height: 0.98;
	}

	.section-header p:last-child {
		margin: 1rem 0 0;
		font-size: 1.02rem;
	}
</style>
