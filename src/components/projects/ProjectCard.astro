---
import type { Project } from '../../lib/types';
import PlaceholderFrame from '../common/PlaceholderFrame.astro';

interface Props {
	project: Project;
	variant?: 'featured' | 'compact';
}

const { project, variant = 'compact' } = Astro.props;
const links = [
	{ label: 'Live', href: project.links.live },
	{ label: 'GitHub', href: project.links.github },
	{ label: 'Play Store', href: project.links.playStore },
	{ label: 'App Store', href: project.links.appStore },
].filter((link) => link.href);

const isPlaceholder = (href: string) => href.startsWith('[');
---

<article class={`project-card project-card--${variant}`}>
	<div class="project-media">
		<PlaceholderFrame label="[PROJECT_SCREENSHOT]" aspect="16 / 10" />
	</div>
	<div class="project-body">
		<div class="project-kicker">
			<span>{project.categoryLabel}</span>
			<span>{project.ownershipLabel}</span>
		</div>
		<h3>{project.title}</h3>
		<p class="project-description">{project.description}</p>
		<p class="project-role"><strong>Role:</strong> {project.role}</p>
		{project.notes && (
			<ul class="project-notes">
				{project.notes.map((note) => <li>{note}</li>)}
			</ul>
		)}
		<div class="tech-row" aria-label={`${project.title} technologies`}>
			{project.technologies.map((tech) => <span>{tech}</span>)}
		</div>
		{links.length > 0 && (
			<div class="project-links" aria-label={`${project.title} links`}>
				{links.map((link) =>
					isPlaceholder(link.href) ? (
						<span class="link-placeholder">{link.label}: {link.href}</span>
					) : (
						<a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
					)
				)}
			</div>
		)}
	</div>
</article>

<style>
	.project-card {
		overflow: hidden;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-md);
		background: var(--color-paper-raised);
		box-shadow: var(--shadow-soft);
	}

	.project-card--featured {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
		align-items: stretch;
	}

	.project-card--compact {
		display: grid;
	}

	.project-media {
		min-width: 0;
	}

	.project-card--featured .project-media :global(.placeholder-frame) {
		height: 100%;
		min-height: 22rem;
		border: 0;
		border-radius: 0;
	}

	.project-card--compact .project-media :global(.placeholder-frame) {
		border: 0;
		border-bottom: 1px solid var(--color-line);
		border-radius: 0;
	}

	.project-body {
		display: grid;
		align-content: start;
		gap: 0.9rem;
		padding: clamp(1rem, 3vw, 1.6rem);
	}

	.project-kicker {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.project-kicker span,
	.tech-row span,
	.link-placeholder {
		border: 1px solid var(--color-line);
		border-radius: 999px;
		background: var(--color-accent-soft);
		padding: 0.28rem 0.55rem;
		color: var(--color-accent-strong);
		font-size: 0.72rem;
		font-weight: 850;
		line-height: 1.2;
	}

	.project-kicker span:nth-child(2) {
		background: var(--color-paper);
		color: var(--color-clay);
	}

	h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.65rem, 4vw, 3rem);
		line-height: 0.98;
	}

	.project-card--compact h3 {
		font-size: clamp(1.4rem, 3vw, 2rem);
	}

	p {
		margin: 0;
	}

	.project-description,
	.project-role,
	.project-notes {
		color: var(--color-ink-soft);
	}

	.project-role strong {
		color: var(--color-ink);
	}

	.project-notes {
		margin: 0;
		padding-left: 1.1rem;
	}

	.project-notes li + li {
		margin-top: 0.35rem;
	}

	.tech-row,
	.project-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.project-links a {
		border-bottom: 1px solid currentColor;
		color: var(--color-accent-strong);
		font-size: 0.82rem;
		font-weight: 850;
		text-decoration: none;
	}

	.link-placeholder {
		background: var(--color-paper);
		color: var(--color-ink-muted);
	}

	@media (max-width: 860px) {
		.project-card--featured {
			grid-template-columns: 1fr;
		}

		.project-card--featured .project-media :global(.placeholder-frame) {
			min-height: auto;
			border-bottom: 1px solid var(--color-line);
		}
	}
</style>
