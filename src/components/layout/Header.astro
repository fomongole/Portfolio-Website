---
import { navItems, site, socials } from '../../data/site';
import ThemeToggle from './ThemeToggle.astro';

const githubLinks = socials.filter((social) => social.href.includes('github.com'));
const currentPath = Astro.url.pathname;
const normalizePath = (path: string) => (path === '/' ? '/' : path.replace(/\/$/, ''));
const isCurrent = (href: string) => {
	const normalizedHref = normalizePath(href);
	const normalizedCurrent = normalizePath(currentPath);
	return normalizedHref === '/'
		? normalizedCurrent === '/'
		: normalizedCurrent === normalizedHref || normalizedCurrent.startsWith(`${normalizedHref}/`);
};
---

<header class="site-header">
	<nav class="site-container nav-shell" aria-label="Primary navigation">
		<a class="brand" href="/" aria-label={`${site.name} home`} aria-current={isCurrent('/') ? 'page' : undefined}>
			<span>EF</span>
			<strong>{site.name}</strong>
		</a>
		<div class="nav-links">
			{navItems.map((item) => (
				<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
			))}
		</div>
		<div class="nav-actions">
			<div class="github-actions" aria-label="GitHub profiles">
				{githubLinks.map((social) => (
					<a href={social.href} target="_blank" rel="noreferrer">{social.shortLabel}</a>
				))}
			</div>
			<ThemeToggle />
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		border-bottom: 1px solid color-mix(in srgb, var(--color-line), transparent 22%);
		background: color-mix(in srgb, var(--color-paper), transparent 8%);
		backdrop-filter: blur(16px);
		transition:
			background-color var(--duration-base) var(--ease-out),
			border-color var(--duration-base) var(--ease-out);
	}

	.nav-shell {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		padding-block: 1rem;
	}

	.brand,
	.nav-links,
	.nav-actions {
		display: flex;
		align-items: center;
	}

	.brand {
		gap: 0.75rem;
		text-decoration: none;
	}

	.brand span {
		display: grid;
		width: 2.45rem;
		height: 2.45rem;
		place-items: center;
		border-radius: var(--radius-sm);
		background: var(--color-ink);
		color: var(--color-paper);
		font-size: 0.8rem;
		font-weight: 900;
		letter-spacing: 0.08em;
	}

	.brand strong {
		font-size: 0.94rem;
	}

	.nav-links {
		gap: clamp(0.8rem, 2vw, 1.45rem);
		font-size: 0.86rem;
		font-weight: 800;
	}

	.nav-links a {
		position: relative;
		color: var(--color-ink-soft);
		text-decoration: none;
	}

	.nav-links a:hover,
	.nav-links a[aria-current="page"] {
		color: var(--color-ink);
	}

	.nav-links a::after {
		position: absolute;
		right: 0;
		bottom: -0.48rem;
		left: 0;
		height: 2px;
		border-radius: 999px;
		background: var(--color-clay);
		content: "";
		opacity: 0;
		transform: scaleX(0.25);
		transform-origin: center;
		transition:
			opacity var(--duration-fast) var(--ease-out),
			transform var(--duration-fast) var(--ease-out);
	}

	.nav-links a:hover::after,
	.nav-links a[aria-current="page"]::after {
		opacity: 1;
		transform: scaleX(1);
	}

	.nav-actions {
		justify-content: flex-end;
		gap: 0.8rem;
	}

	.github-actions {
		display: flex;
		gap: 0.45rem;
	}

	.github-actions a {
		border: 1px solid var(--color-line);
		border-radius: 999px;
		background: var(--color-paper-raised);
		padding: 0.48rem 0.62rem;
		color: var(--color-ink-soft);
		font-size: 0.72rem;
		font-weight: 850;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
	}

	.github-actions a:hover {
		color: var(--color-ink);
	}

	@media (max-width: 760px) {
		.nav-shell {
			grid-template-columns: 1fr auto;
		}

		.nav-links {
			grid-column: 1 / -1;
			justify-content: space-between;
			overflow-x: auto;
			padding-top: 0.25rem;
		}

		.brand strong {
			display: none;
		}

		.github-actions {
			display: none;
		}
	}

	@media (max-width: 1120px) {
		.github-actions {
			display: none;
		}
	}
</style>
