---
import { Image } from 'astro:assets';
import { getImageSlot } from '../../lib/imageSlots';
import PlaceholderFrame from './PlaceholderFrame.astro';

interface Props {
	assetPath?: string;
	alt: string;
	label: string;
	aspect?: string;
	priority?: boolean;
}

const { assetPath, alt, label, aspect = '16 / 10', priority = false } = Astro.props;
const image = getImageSlot(assetPath);
---

{
	image ? (
		<figure class="media-slot" style={`aspect-ratio: ${aspect}`}>
			<Image
				src={image}
				alt={alt}
				loading={priority ? 'eager' : 'lazy'}
				decoding="async"
				fetchpriority={priority ? 'high' : 'auto'}
				widths={[480, 768, 1200, 1600]}
				sizes="(max-width: 760px) calc(100vw - 2rem), (max-width: 1180px) 50vw, 620px"
			/>
		</figure>
	) : (
		<PlaceholderFrame label={label} aspect={aspect} />
	)
}

<style>
	.media-slot {
		width: 100%;
		margin: 0;
		overflow: hidden;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-md);
		background: var(--color-paper-raised);
	}

	.media-slot :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
