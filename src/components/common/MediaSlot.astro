---
import { Image } from 'astro:assets';
import { getImageSlot } from '../../lib/imageSlots';
import PlaceholderFrame from './PlaceholderFrame.astro';

interface Props {
	assetPath?: string;
	alt: string;
	label: string;
	aspect?: string;
	priority?: boolean;
	kind?: 'web' | 'mobile' | 'brand' | 'system';
	fit?: 'cover' | 'contain';
}

const { assetPath, alt, label, aspect = '16 / 10', priority = false, kind = 'web', fit } = Astro.props;
const image = getImageSlot(assetPath);
const mediaFit = fit || (kind === 'mobile' ? 'contain' : 'cover');
const placeholderLabel = assetPath ? assetPath.replace('/src/assets/images/projects/', '') : label;
---

{
	image ? (
		<figure class={`media-slot media-slot--${kind} media-slot--${mediaFit}`} style={`aspect-ratio: ${aspect}`}>
			<Image
				src={image}
				alt={alt}
				loading={priority ? 'eager' : 'lazy'}
				decoding="async"
				fetchpriority={priority ? 'high' : 'auto'}
				widths={[480, 768, 1200, 1600]}
				sizes="(max-width: 760px) calc(100vw - 2rem), (max-width: 1180px) 50vw, 620px"
			/>
		</figure>
	) : (
		<div class={`media-placeholder media-placeholder--${kind}`} style={`aspect-ratio: ${aspect}`}>
			<PlaceholderFrame label={placeholderLabel} aspect={aspect} />
		</div>
	)
}

<style>
	.media-slot {
		width: 100%;
		margin: 0;
		overflow: hidden;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-md);
		background: var(--color-paper-raised);
	}

	.media-slot :global(img) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.media-slot--cover :global(img) {
		width: 100%;
		object-fit: cover;
	}

	.media-slot--contain :global(img) {
		width: auto;
		object-fit: contain;
	}

	.media-slot--mobile {
		display: grid;
		place-items: center;
		border: 0;
		background: transparent;
		padding: 0;
	}

	.media-slot--mobile :global(img) {
		max-width: 100%;
		height: 100%;
		max-height: 100%;
		border: 1px solid color-mix(in srgb, var(--color-line), var(--color-ink) 12%);
		border-radius: 1.1rem;
		background: var(--color-paper);
		box-shadow: 0 16px 38px rgb(var(--color-shadow) / 0.16);
	}

	.media-placeholder {
		width: 100%;
	}

	.media-placeholder :global(.placeholder-frame) {
		height: 100%;
	}

	.media-placeholder--mobile :global(.placeholder-frame) {
		background:
			linear-gradient(180deg, color-mix(in srgb, var(--color-ink), transparent 95%), transparent),
			var(--color-paper-raised);
	}
</style>
