---
import { availability, site, socials } from '../../data/site';
import ButtonLink from '../ui/ButtonLink.astro';
---

<section class="contact-page">
	<div class="site-container contact-stack">
		<header class="contact-hero">
			<div>
				<p class="eyebrow">Contact / Freelance</p>
				<h1 class="text-balance">Bring Fred in when the product needs calm, capable engineering hands.</h1>
			</div>
			<p class="muted text-pretty">
				For freelance builds, mobile app work, backend systems, product websites, dashboards, and improvements to existing applications, start with a short note about what needs to change.
			</p>
		</header>

		<section class="availability-panel">
			<div>
				<p class="eyebrow">Availability</p>
				<h2>{availability.headline}</h2>
			</div>
			<p>{availability.description}</p>
		</section>

		<div class="contact-grid">
			<section class="contact-methods" aria-label="Contact methods">
				<a class="method method--primary" href={`mailto:${site.email}`}>
					<span>Email</span>
					<strong>{site.email}</strong>
					<small>Best for project briefs and freelance inquiries</small>
				</a>
				<a class="method" href={`tel:${site.phone}`}>
					<span>Phone</span>
					<strong>{site.phone}</strong>
					<small>Good for quick coordination in Uganda</small>
				</a>
				{socials.map((social) => (
					<a class="method" href={social.href} target="_blank" rel="noreferrer">
						<span>{social.shortLabel || social.label}</span>
						<strong>{social.label}</strong>
						<small>{social.href.replace('https://', '')}</small>
					</a>
				))}
			</section>

			<aside class="brief-panel">
				<p class="eyebrow">What to send</p>
				<h2>A useful first message is simple.</h2>
				<ul>
					<li>What you are building or improving</li>
					<li>Whether the work is web, mobile, backend, or full-stack</li>
					<li>What already exists today</li>
					<li>The outcome you need next</li>
				</ul>
				<ButtonLink href={`mailto:${site.email}?subject=Project inquiry for Fred`}>Email a project brief</ButtonLink>
				<p class="form-note">
					Contact form integration is intentionally not shown until a live email service or backend endpoint is wired up.
				</p>
			</aside>
		</div>
	</div>
</section>

<style>
	.contact-page {
		padding-block: clamp(3.5rem, 8vw, 7rem);
	}

	.contact-stack {
		display: grid;
		gap: clamp(2rem, 5vw, 4rem);
	}

	.contact-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.42fr);
		gap: 2rem;
		align-items: end;
	}

	.contact-hero h1 {
		max-width: 13ch;
		margin: 0.75rem 0 0;
		font-family: var(--font-display);
		font-size: clamp(3.1rem, 8vw, 6.6rem);
		line-height: 0.9;
	}

	.contact-hero p:not(.eyebrow) {
		font-size: 1.08rem;
	}

	.availability-panel {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.44fr);
		gap: 2rem;
		align-items: end;
		border-radius: var(--radius-md);
		background: var(--color-ink);
		color: var(--color-paper);
		padding: clamp(1.25rem, 5vw, 3rem);
	}

	.availability-panel .eyebrow {
		color: var(--color-clay);
	}

	.availability-panel h2 {
		max-width: 15ch;
		margin: 0.65rem 0 0;
		font-family: var(--font-display);
		font-size: clamp(2.2rem, 5vw, 4.8rem);
		line-height: 0.92;
	}

	.availability-panel p:not(.eyebrow) {
		color: color-mix(in srgb, var(--color-paper), transparent 16%);
	}

	.contact-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.42fr);
		gap: 1rem;
		align-items: start;
	}

	.contact-methods {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1px;
		overflow: hidden;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-md);
		background: var(--color-line);
	}

	.method {
		display: grid;
		min-height: 10rem;
		align-content: space-between;
		gap: 0.8rem;
		background: var(--color-paper-raised);
		padding: clamp(1rem, 3vw, 1.35rem);
		text-decoration: none;
	}

	.method--primary {
		grid-column: 1 / -1;
		min-height: 12rem;
	}

	.method span {
		color: var(--color-clay);
		font-size: 0.72rem;
		font-weight: 850;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.method strong {
		font-family: var(--font-display);
		font-size: clamp(1.45rem, 3vw, 2.25rem);
		line-height: 1;
		overflow-wrap: anywhere;
	}

	.method small {
		color: var(--color-ink-soft);
		font-size: 0.86rem;
	}

	.method:hover strong {
		color: var(--color-accent-strong);
	}

	.brief-panel {
		display: grid;
		gap: 1rem;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-md);
		background: var(--color-paper-raised);
		padding: clamp(1rem, 3vw, 1.45rem);
	}

	.brief-panel h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.8rem, 4vw, 3rem);
		line-height: 0.98;
	}

	.brief-panel ul {
		display: grid;
		gap: 0.5rem;
		margin: 0;
		padding-left: 1.1rem;
		color: var(--color-ink-soft);
	}

	.form-note {
		margin: 0;
		color: var(--color-ink-muted);
		font-size: 0.86rem;
	}

	@media (max-width: 900px) {
		.contact-hero,
		.availability-panel,
		.contact-grid,
		.contact-methods {
			grid-template-columns: 1fr;
		}

		.method--primary {
			grid-column: auto;
		}
	}
</style>
