---
import { featuredProjects } from '../../data/projects';
import PlaceholderFrame from '../common/PlaceholderFrame.astro';
import SectionHeader from '../ui/SectionHeader.astro';
---

<section class="work-section" id="selected-work">
	<div class="site-container section-stack">
		<SectionHeader
			eyebrow="Selected work"
			title="A project model ready for real case studies."
			description="The first featured slots are intentionally reserved, with stable screenshot ratios and metadata ready for real client and product stories."
		/>
		<div class="work-grid">
			{featuredProjects.map((project) => (
				<article class="project-card">
					<PlaceholderFrame label={project.category} aspect="16 / 10" />
					<div class="project-copy">
						<p class="project-meta">{project.year} · {project.platform.join(' / ')}</p>
						<h3>{project.title}</h3>
						<p>{project.description}</p>
						<div class="tech-row" aria-label="Technologies">
							{project.technologies.slice(0, 4).map((tech) => <span>{tech}</span>)}
						</div>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.work-section {
		padding-block: clamp(3rem, 7vw, 5.5rem);
		border-top: 1px solid var(--color-line);
	}

	.section-stack {
		display: grid;
		gap: 2rem;
	}

	.work-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.project-card {
		overflow: hidden;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-md);
		background: var(--color-paper-raised);
		box-shadow: var(--shadow-soft);
	}

	.project-copy {
		padding: clamp(1rem, 3vw, 1.45rem);
	}

	.project-meta {
		margin: 0;
		color: var(--color-clay);
		font-size: 0.76rem;
		font-weight: 850;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h3 {
		margin: 0.55rem 0 0;
		font-family: var(--font-display);
		font-size: clamp(1.45rem, 3vw, 2rem);
		line-height: 1.05;
	}

	.project-copy > p:not(.project-meta) {
		margin: 0.75rem 0 0;
		color: var(--color-ink-soft);
	}

	.tech-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-top: 1.2rem;
	}

	.tech-row span {
		border: 1px solid var(--color-line);
		border-radius: 999px;
		background: var(--color-accent-soft);
		padding: 0.28rem 0.55rem;
		color: var(--color-accent-strong);
		font-size: 0.75rem;
		font-weight: 800;
	}

	@media (max-width: 760px) {
		.work-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
