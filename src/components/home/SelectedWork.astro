---
import { featuredProjects } from '../../data/projects';
import ProjectCard from '../projects/ProjectCard.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import ButtonLink from '../ui/ButtonLink.astro';
---

<section class="work-section" id="selected-work">
	<div class="site-container section-stack">
		<SectionHeader
			eyebrow="Selected work"
			title="A few product builds with real operational surface area."
			description="Rentora, Bllar, and Afrodoctor show Fred’s range across full-stack systems, Flutter apps, product operations, and release-ready mobile work."
		/>
		<div class="work-grid">
			{featuredProjects.map((project) => (
				<ProjectCard project={project} />
			))}
		</div>
		<ButtonLink href="/work/" variant="secondary">Browse all projects</ButtonLink>
	</div>
</section>

<style>
	.work-section {
		padding-block: clamp(3rem, 7vw, 5.5rem);
		border-top: 1px solid var(--color-line);
	}

	.section-stack {
		display: grid;
		gap: 2rem;
	}

	.work-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	@media (max-width: 980px) {
		.work-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
