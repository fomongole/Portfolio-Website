---
import { capabilities } from '../../data/capabilities';
import { skillGroups } from '../../data/skills';
import SectionHeader from '../ui/SectionHeader.astro';
---

<section class="capabilities-section">
	<div class="site-container capabilities-grid">
		<SectionHeader
			eyebrow="Capabilities"
			title="Enough range to own the product, enough taste to keep it coherent."
		/>
		<div class="capability-list">
			{capabilities.map((item) => (
				<article>
					<h3>{item.title}</h3>
					<p>{item.description}</p>
				</article>
			))}
		</div>
		<div class="skills-strip">
			{skillGroups.map((group) => (
				<div>
					<strong>{group.label}</strong>
					<p>{group.summary}</p>
					<ul>
						{group.items.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.capabilities-section {
		padding-block: clamp(3rem, 7vw, 5.5rem);
		background: color-mix(in srgb, var(--color-paper-raised), var(--color-paper) 28%);
		border-block: 1px solid var(--color-line);
	}

	.capabilities-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 4rem);
	}

	.capability-list {
		display: grid;
		gap: 1px;
		overflow: hidden;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-md);
		background: var(--color-line);
	}

	.capability-list article {
		background: var(--color-paper);
		padding: clamp(1.1rem, 3vw, 1.55rem);
	}

	h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.45rem;
		line-height: 1.05;
	}

	.capability-list p,
	.skills-strip p {
		margin: 0.55rem 0 0;
		color: var(--color-ink-soft);
	}

	.skills-strip ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}

	.skills-strip li {
		border: 1px solid var(--color-line);
		border-radius: 999px;
		padding: 0.22rem 0.45rem;
		color: var(--color-accent-strong);
		font-size: 0.72rem;
		font-weight: 850;
	}

	.skills-strip {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1px;
		overflow: hidden;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-md);
		background: var(--color-line);
	}

	.skills-strip div {
		min-height: 12rem;
		background: var(--color-paper-raised);
		padding: 1.1rem;
	}

	.skills-strip strong {
		color: var(--color-clay);
		font-size: 0.78rem;
		font-weight: 900;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	@media (max-width: 820px) {
		.capabilities-grid,
		.skills-strip {
			grid-template-columns: 1fr;
		}
	}
</style>
